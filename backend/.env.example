PORT=3000
MONGODB_URI=mongodb://localhost:27017/eventtick
JWT_SECRET_KEY=ticketerra_secret_key_2026_jwt

# Cấu hình lưu trữ ảnh Cloudinary (lấy từ https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Cấu hình gửi email qua SMTP (Gmail App Password)
# Để trống thì hệ thống sẽ tự động in link kích hoạt/reset ra console terminal để test
CLIENT_URL=http://localhost:5173
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Ticketerra Support" <no-reply@ticketerra.com>


# Redis (giữ ghế 10 phút) — đã tích hợp
REDIS_URL=redis://localhost:6379

# SePay (thanh toán chuyển khoản qua webhook) — đã tích hợp, xem README mục "Cấu hình SePay"
SEPAY_WEBHOOK_API_KEY=
SEPAY_BANK_ACCOUNT=
SEPAY_BANK_NAME=
SEPAY_PAYMENT_PREFIX=DH
# Đặt false khi chạy thật để tắt thanh toán giả lập
ENABLE_DEMO_PAYMENT=true

# --- Chưa được code sử dụng, sẽ dùng khi chuyển sang đăng nhập Google ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
